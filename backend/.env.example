# Plantilla. Copiar a .env y poner ahi los valores reales:
#   cp .env.example .env
#
# .env esta en .gitignore y lo carga DotEnvEnvironmentPostProcessor al arrancar, tanto desde el IDE
# como desde ./mvnw spring-boot:run. Una variable de entorno real siempre gana sobre el archivo.
#
# ESTE ARCHIVO SE VERSIONA: no poner secretos aqui, solo valores de ejemplo.

# Obligatoria. Minimo 32 caracteres. Sin ella la aplicacion no arranca.
# Generar uno propio, por ejemplo:  openssl rand -base64 48
JWT_SECRET=reemplazar-por-un-secreto-propio-de-32-caracteres-minimo
JWT_EXPIRES_IN=8h

PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=novaeyetech
DB_USERNAME=postgres
DB_PASSWORD=postgres
# update en desarrollo; validate o none en produccion
DB_SYNC=update
DB_LOGGING=false

CORS_ALLOWED_ORIGINS=http://localhost:4200

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Almacenamiento de imagenes y documentos (evidencias de mantenimiento, foto de perfil).
# Sin estas credenciales la aplicacion arranca, pero cualquier subida responde 400.
# Se obtienen en el dashboard de Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=novaeyetech

# Datos de demostracion. Solo desarrollo.
SEED_ENABLED=false

# Datos impresos en la cabecera del PDF de cotizacion
COMPANY_NAME=NEXT EYE SECURITY
COMPANY_TAGLINE=Tu aliado en seguridad
COMPANY_TAX_ID=1717345407001
COMPANY_ADDRESS=De los Guabos y Av. El Inca
COMPANY_PHONE=0969379333
